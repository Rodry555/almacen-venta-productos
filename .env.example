# ------------------------------------------------------------------
# LOCAL (docker compose) — copia este archivo como .env
# ------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=almacen
DB_USER=almacen
DB_PASS=almacen_secret
# En local no se usa TLS; dejar vacío
DB_SSL_CA=
DB_SSL_CA_B64=

APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true

# Cloudinary (si están vacíos, los productos se guardan sin imagen y se avisa)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# PRODUCCIÓN (Render + TiDB Cloud Starter) — variables del panel de Render
# ------------------------------------------------------------------
# DB_HOST=gatewayXXXX.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=almacen
# DB_USER=XXXXXX.root          <- el prefijo de cuenta es OBLIGATORIO
# DB_PASS=************
# DB_SSL_CA_B64=II...          <- CA de TiDB en base64 (no es secreto, pero así no hay que montar archivos)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tu-servicio.onrender.com
