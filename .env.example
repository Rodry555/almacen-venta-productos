# ------------------------------------------------------------------
# LOCAL (docker compose) — copia este archivo como .env
# ------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=test
DB_USER=almacen
DB_PASS=almacen_secret

# ------------------------------------------------------------------
# PRODUCCIÓN (Render + TiDB Cloud) — una sola variable de entorno
# ------------------------------------------------------------------
# DB_URL=mysql://USUARIO:PASSWORD@HOST:4000/test
# DATABASE_URL se acepta como alias. El CA del sistema se usa automáticamente.
# Cloudinary es opcional; sin estas variables las imágenes usan placeholder:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
